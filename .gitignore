# Isolated implementation worktrees
/.worktrees/

# Rust and desktop build output
/target
crates/rsetup-tunnel/target/
/apps/desktop/node_modules
/apps/desktop/dist
/apps/desktop/src-tauri/target
/apps/desktop/src-tauri/gen/schemas
# Frontend staging for the desktop build script. It normally lives under
# src-tauri/target (ignored above); these cover the last-resort root beside
# dist and the retired per-pid layout, so an interrupted build never shows up
# as untracked noise even before the next build reclaims it.
/apps/desktop/rsetup-dist-staging/
/apps/desktop/.rsetup-dist-staging-*

# Debian build output and package-local Cargo cache. The three per-package staging
# directories below are created by dh_install from debian/rules; rsetup-board-agent
# is the newest of them and is listed explicitly so an interrupted package build
# never leaves a staging tree showing up as untracked noise.
/debian/.debhelper
/debian/cargo-home
/debian/rsetup-next
/debian/rsetup-controller
/debian/rsetup-board-agent
/debian/tmp
/debian/debhelper-build-stamp
/debian/files
/debian/*.debhelper
/debian/*.debhelper.log
/debian/*.substvars
/*.deb
/*.buildinfo
/*.changes
/.pc

# Editors, local environment, and review artifacts
/.cargo-local/
/.vscode*
/.impeccable/review
.env
.env.*
!.env.example
secret/

# Multi-agent orchestration scratch (team roster, inboxes, task leases). Local
# tooling state, never part of the tree.
/.agent-teams/

# SDD subagent-driven-development scratch workspace (briefs, reports, ledger).
# One task's ledger is tracked on purpose: the MMC storage TUI run is the audit
# trail behind the TUI commits and is cited by the test report.
.superpowers/*
!.superpowers/sdd/
.superpowers/sdd/*
!.superpowers/sdd/2026-09-12-mmc-storage-tui-tdd-plan/

# ---------------------------------------------------------------------------
# 本地产物：本地构建缓存与 QA 脚本，只留在开发机上，不纳入版本控制。
# ---------------------------------------------------------------------------

# 本地隔离的 CARGO_HOME 与 CARGO_TARGET_DIR（离线/交叉构建缓存）。
/.cargo-home/
/.cargo-target/

# 仓库根误生成的 npm 脚手架与 pnpm lockfile。正式前端在 apps/controller-web，
# 构建口径统一为 npm，只跟踪 apps/controller-web/package-lock.json。
/node_modules/
/package.json
/pnpm-lock.yaml
# 在 apps/controller-web 目录内直接跑 pnpm 也会就地再生成一份 pnpm-lock.yaml；
# 它与「package-lock.json 唯一锁文件」的口径冲突，显式忽略以免被误提交。
/apps/controller-web/pnpm-lock.yaml
# 中控前端产物 apps/controller-web/dist 是 vite 每次构建现生成的，不入库；忽略规则
# 只由 apps/controller-web/.gitignore 声明这一处。本文件**既不重新忽略也不
# 反向放行**（尤其不得出现 `!apps/controller-web/dist` 之类的重包含），否则两处
# 规则相互覆盖，产物会随本地构建状态忽隐忽现。上文的 /apps/desktop/dist 属桌面端
# Tauri 的另一套产物，与本条无关。

# Python 字节码缓存（脚本与 Python 测试运行时生成，任意层级）。
__pycache__/
*.pyc

# 手误重定向（形如 `cmd > =`）留下的空文件。
/=

# 本地 QA 截图脚本，不纳入版本控制。
/scripts/capture_all_spa_views.py
/scripts/capture_full_views.py
/scripts/capture_qa_views.py
/scripts/debug_page_render.py
/scripts/full_feature_visual_qa.py
/scripts/generate_all_views_screenshots.py
/scripts/test_browser_render.py
