# /usr/share/doc/rsetup-controller/rsetup-controller.default — rsetup-controller 示例配置。
#
# 本样例作为文档示例随包安装，权限 0644 且**不含任何秘密**。
# 部署时请复制为 /etc/default/rsetup-controller 并填入真实值，随后立刻收紧权限：
#
#     sudo cp /usr/share/doc/rsetup-controller/rsetup-controller.default /etc/default/rsetup-controller
#     sudo chmod 0600 /etc/default/rsetup-controller
#
# systemd 的 EnvironmentFile 语法是 KEY=VALUE 逐行赋值：不认识的行必须是注释（以 # 开头），
# 值不要加 shell 的 $、反引号或命令替换（EnvironmentFile 不经过 shell，写了也不会展开）。
#
# 修改后需要 `sudo systemctl restart rsetup-controller` 生效。完整安装后步骤见
# /usr/share/doc/rsetup-controller/README.Debian。

# --- 必填：缺少任意一项，进程直接退出（fail-closed），不会带空配置监听 ---

# 数据库连接串（MySQL/TiDB），含账号与口令。**这是本文件里唯一的秘密**，务必 0600。
# 同一变量也被 rsetup-controller-migrate 使用（迁移目标就是这里指向的库）。
#CONTROLLER_DATABASE_URL=

# 精确匹配的 Host 白名单，逗号分隔。只放中控实际被访问的名字，例如：
#CONTROLLER_ALLOWED_HOSTS=127.0.0.1:8080,controller.internal.example
# 说明：默认监听是 127.0.0.1:8080；上面这行是"经反代访问时也允许反代传来的 Host"的写法示例。

# 唯一精确匹配的浏览器 Origin（含 scheme 与端口，不能带通配符与路径）。
#CONTROLLER_ALLOWED_ORIGIN=https://controller.internal.example

# 管理 cursor 的密钥：十六进制编码的随机串（例如 openssl rand -hex 32 的输出）。
#CONTROLLER_MANAGEMENT_CURSOR_SECRET_HEX=

# --- 可选 ---

# 监听地址。默认 127.0.0.1:8080，仅回环。中控自身不终止 TLS，也不面向不可信网络；
# 需要跨机访问时请放在反向代理 + TLS + 可信管理网之后，并同步上面的 Host/Origin。
#CONTROLLER_LISTEN_ADDRESS=127.0.0.1:8080

# 仅当反代已终止 TLS 时设为 1 或 true（给会话 Cookie 追加 Secure）；其他取值是启动错误。
#CONTROLLER_TRUST_TLS=

# 一次性管理员凭据的输出文件；systemd 单元已把它固定在
# /var/lib/rsetup-controller/bootstrap-secret.log，一般无需在此覆盖。
#CONTROLLER_BOOTSTRAP_SECRET_LOG=/var/lib/rsetup-controller/bootstrap-secret.log

# --- 仅在执行 rsetup-controller-migrate --apply 时需要（不要长期留在本文件里） ---
#
# 这四项是迁移门禁，只为把"目标已确认、已有真实备份、已确认独占访问"由操作员显式表达出来。
# `--check` 只读，不需要它们。建议用一次性环境（或 sudo -E）传入，迁移完成后清除。
#
# 必须恰好是 1。
#CONTROLLER_MIGRATION_ALLOW_DESTRUCTIVE=1
# 必须与数据库真实返回的库名逐字相同；不一致时迁移直接失败，不会碰另一个库。
#CONTROLLER_MIGRATION_EXPECTED_DATABASE=
# 指向**真实存在**的备份产物（备份文件或校验清单）的路径/引用；空或空白即拒绝迁移。
#CONTROLLER_MIGRATION_BACKUP_REF=
# 必须逐字等于 isolated-exclusive-backed-up-disposable，语义是"已隔离独占 + 已备份"；
# 对生产库它不表示数据可以丢弃。
#CONTROLLER_MIGRATION_ACK=
