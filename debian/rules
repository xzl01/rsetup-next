#!/usr/bin/make -f

export CARGO_HOME := $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR := $(CURDIR)/target
export CARGO_NET_OFFLINE := true
export CARGO_TERM_COLOR := never
export CARGO_PROFILE_RELEASE_DEBUG := 1

%:
	dh $@ --buildsystem=none

# One source package, three binary packages. The Rust side builds with cargo in offline
# mode against the package-local debian/cargo-home (the npm step below is the one part
# of the build that needs a network or a warm npm cache):
#   rsetup-next        — the CLI/TUI/Web binary, its narrow privileged helper, the Polkit
#                        policy, the thermal/fan-curve/LED units and the tmpfiles.d rule;
#   rsetup-controller  — the loopback Web control centre, its two operator CLIs
#                        (rsetup-controller-migrate, rsetup-admin), the systemd unit and the
#                        example configuration file (installed to doc);
#   rsetup-board-agent — the board-side agent binary (its systemd unit starts the
#                        production --connect mode: outbound encrypted session,
#                        read-only business) and that unit.
#
# The controller embeds its web UI at compile time (crates/rsetup-controller/build.rs
# reads apps/controller-web/dist), and that dist is a generated artifact: it does not
# ship in the source package, its file names carry a vite content hash, and nothing in
# this file hardcodes one. override_dh_auto_build therefore builds the frontend with
# npm — the locked install plus `vite build` — before the first cargo invocation, which
# is why both nodejs and npm are Build-Depends. Only the Rust side stays
# network-isolated (CARGO_NET_OFFLINE plus the package-local debian/cargo-home); the
# npm install needs a reachable npm cache. The test step below runs the whole
# workspace, controller crate included, against that freshly generated dist, and
# `node --test ui/*.test.mjs` covers the browser side of this repository.
#
# The controller and the board agent units are installed but neither enabled,
# started nor restarted on upgrade (override_dh_installsystemd below, plus the controller
# unit's own ConditionPathExists). Connecting to a real database, running a migration and
# writing /etc/default/rsetup-controller are operator actions; see
# debian/rsetup-controller.README.Debian. On the board side the unit ships the
# production --connect mode (outbound encrypted session, read-only business), so
# deciding whether a board should run the agent at all is likewise an operator
# decision; see debian/rsetup-board-agent.README.Debian.
#
# deviceinfo is a Git submodule linked as a Cargo path dependency. A Debian
# build must start from a recursive clone; GitHub source archives omit it.
.PHONY: check-submodule
check-submodule:
	@test -f externals/devicesinfo/crates/deviceinfo/Cargo.toml || { \
	  echo "externals/devicesinfo is not initialized." >&2; \
	  echo "Run: git submodule update --init --recursive" >&2; \
	  exit 1; \
	}

# The frontend is a build input of rsetup-controller, never a committed artifact, so it
# is generated here first: `npm ci` installs the tree pinned by
# apps/controller-web/package-lock.json, and `npm run build` writes
# apps/controller-web/dist with whatever file names vite chose for this build. These two
# lines must stay ahead of every cargo line below — build.rs reads that dist at compile
# time and fails closed when it is missing. Nothing here needs to know the generated
# names; build.rs discovers the assets by scanning the dist directory.
override_dh_auto_build: check-submodule
	npm --prefix apps/controller-web ci
	npm --prefix apps/controller-web run build
	cargo rustc -p rsetup-next --release --bin rsetup-next --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-next --release --bin rsetup-next-helper --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-controller --release --bin rsetup-controller --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-controller --release --bin rsetup-controller-migrate --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-controller --release --bin rsetup-admin --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-board-agent --release --bin rsetup-board-agent --locked --offline -- -C target-feature=+crt-static

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	# The whole workspace, rsetup-controller included. Its compile-time web asset table
	# reads apps/controller-web/dist, the dist generated by the npm build in
	# override_dh_auto_build above — the source package carries no frontend artifact, so
	# building and testing the crate needs that frontend build step and nothing else.
	cargo test --workspace --release --locked --offline
	node --test ui/*.test.mjs
endif

# The tmpfiles.d rule creates the root-only /run/rsetup-next, which the SPI flash
# manager stages its private work tree under. debhelper's dh_installtmpfiles
# installs debian/rsetup-next.tmpfiles to the same destination; the explicit line
# keeps every packaged path visible in one place and does not depend on that
# helper being part of the dh sequence in use.
# The static binaries are built immediately before they are installed, not only in
# dh_auto_build. `dh_auto_test` runs
# `cargo test --workspace --release --locked --offline`, and any
# integration test that uses `CARGO_BIN_EXE_*` makes cargo produce the plain
# `target/release/<binary>` — without `+crt-static` — overwriting the static one
# that was built above. Installing from freshly rebuilt binaries makes every
# packaged artifact independent of what the test step happened to build.
override_dh_auto_install:
	cargo rustc -p rsetup-next --release --bin rsetup-next --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-next --release --bin rsetup-next-helper --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-controller --release --bin rsetup-controller --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-controller --release --bin rsetup-controller-migrate --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-controller --release --bin rsetup-admin --locked --offline -- -C target-feature=+crt-static
	cargo rustc -p rsetup-board-agent --release --bin rsetup-board-agent --locked --offline -- -C target-feature=+crt-static
	install -Dm755 target/release/rsetup-next debian/rsetup-next/usr/bin/rsetup-next
	install -Dm755 target/release/rsetup-next-helper debian/rsetup-next/usr/libexec/rsetup-next-helper
	install -Dm644 data/com.radxa.rsetup-next.policy debian/rsetup-next/usr/share/polkit-1/actions/com.radxa.rsetup-next.policy
	install -Dm644 data/rsetup-next-thermal-policy.service debian/rsetup-next/usr/lib/systemd/system/rsetup-next-thermal-policy.service
	install -Dm644 data/rsetup-next-fan-curve.service debian/rsetup-next/usr/lib/systemd/system/rsetup-next-fan-curve.service
	install -Dm644 data/rsetup-next-led-state.service debian/rsetup-next/usr/lib/systemd/system/rsetup-next-led-state.service
	install -Dm644 debian/rsetup-next.tmpfiles debian/rsetup-next/usr/lib/tmpfiles.d/rsetup-next.conf
	install -Dm755 target/release/rsetup-controller debian/rsetup-controller/usr/bin/rsetup-controller
	install -Dm755 target/release/rsetup-controller-migrate debian/rsetup-controller/usr/bin/rsetup-controller-migrate
	install -Dm755 target/release/rsetup-admin debian/rsetup-controller/usr/bin/rsetup-admin
	install -Dm644 data/rsetup-controller.service debian/rsetup-controller/usr/lib/systemd/system/rsetup-controller.service
	# Configuration example: 0644 documentation file, secret-free by construction.
	# The operator copies it to /etc/default/rsetup-controller, populates secrets,
	# and tightens permissions to 0600 before starting the service.
	install -Dm644 debian/rsetup-controller.default debian/rsetup-controller/usr/share/doc/rsetup-controller/rsetup-controller.default
	install -Dm644 debian/rsetup-controller.README.Debian debian/rsetup-controller/usr/share/doc/rsetup-controller/README.Debian
	install -Dm755 target/release/rsetup-board-agent debian/rsetup-board-agent/usr/bin/rsetup-board-agent
	install -Dm644 data/rsetup-board-agent.service debian/rsetup-board-agent/usr/lib/systemd/system/rsetup-board-agent.service
	install -Dm644 debian/rsetup-board-agent.README.Debian debian/rsetup-board-agent/usr/share/doc/rsetup-board-agent/README.Debian

# The controller and the board agent are shipped disabled *and* never started.
# --no-enable alone is not enough: dh_installsystemd(1) documents that it "does not affect
# whether the services are started", so without --no-start the generated postinst still
# carries `deb-systemd-invoke start` and dpkg would bring up a service that needs a
# configured database and a migrated schema — and, on the board side, an always-on
# root-owned agent that would dial the controller over the production tunnel the
# moment a site configuration file exists. --no-start
# drops every start/restart snippet (postinst-systemd-start, postinst-systemd-restart,
# prerm-systemd-restart), and --no-stop-on-upgrade additionally drops the preinst stop, so
# upgrading the package neither starts, restarts nor stops anything: a service an operator
# started by hand keeps running across upgrades, and one they stopped stays stopped.
# --no-enable keeps the units out of the boot path and out of the purge-time disable list.
#
# An override replaces the helper for **every** binary package — dh does not fall back to
# the default sequence for the packages an override omits — so rsetup-next has to be
# invoked explicitly. Its thermal/fan-curve/LED units keep the default enable (that is what
# makes the board thermally safe after the next reboot) and only opt out of the automatic
# start; they are ordinary hardware-policy units with no operator configuration step in
# front of them. --no-stop-on-upgrade is there for the same reason taken one step further:
# without it dh_installsystemd emits `deb-systemd-invoke stop` in the preinst, and since
# --no-start removes the matching start, an upgrade would leave the fan-curve daemon stopped
# and the thermal policy inactive until the next boot.
#
# What the helper *sees* is the other half of the promise. These units ship in
# /usr/lib/systemd/system, and dh_installsystemd resolves that path only from debhelper
# 13.11.6 — the changelog entry "Support units below /usr" at
# https://metadata.ftp-master.debian.org/changelogs/main/d/debhelper/unstable_changelog.
# That is why debian/control pins Build-Depends: debhelper (>= 13.11.6~) next to
# debhelper-compat (= 13): with an older helper the calls above would be a plain no-op
# (units never found, scripts generated without any snippet), and scripts that merely
# "contain no activation" would prove nothing. The floor fails dpkg-checkbuilddeps before
# any build rule runs; building with dpkg-buildpackage -d to step over that failure and
# then pointing at the generated scripts is exactly the false positive this floor exists
# to prevent, and it is not a Rust version pin — it constrains the build tool only.
#
# With the floor in place (Debian 13 builds with debhelper 13.24.x) the assertions on the
# built .deb files are not vacuous: the rsetup-next postinst really carries the
# deb-systemd-helper enable snippet covering all three units, and the
# `Assert Debian systemd maintainer scripts` step of .github/workflows/ci.yml asserts
# that positively, alongside the audit that no start/restart snippet exists. One boundary
# stays documented: from debhelper 13.25 the generated prerm always stops a running
# service on remove ("Always stop the service on remove", Debian bug #1079181 in the same
# changelog). That remove-branch stop is an allowed lifecycle action; this source package
# promises that *installation and upgrades* never start, restart or stop anything, not
# that removing the package leaves a running service alone. The CI audit script
# (scripts/lib/systemd-maintainer-audit.mjs) encodes exactly that split — it does not
# treat every deb-systemd-invoke stop as a violation, and it does not ignore stops either.
#
# dh_installinit would install debian/rsetup-controller.default as /etc/default/rsetup-controller
# (conffile). The controller package intentionally ships its configuration template only under
# /usr/share/doc/rsetup-controller/rsetup-controller.default, so override dh_installinit to exclude
# rsetup-controller (running only for rsetup-next and rsetup-board-agent).
override_dh_installinit:
	dh_installinit -prsetup-next
	dh_installinit -prsetup-board-agent

override_dh_installsystemd:
	dh_installsystemd -prsetup-next --no-start --no-stop-on-upgrade
	dh_installsystemd -prsetup-controller --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd -prsetup-board-agent --no-enable --no-start --no-stop-on-upgrade

override_dh_auto_clean:
	cargo clean
