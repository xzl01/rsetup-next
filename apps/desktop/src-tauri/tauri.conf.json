{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rsetup",
  "version": "0.5.0-alpha.1",
  "identifier": "com.radxa.rsetup",
  "build": {
    "frontendDist": "../../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rsetup · Mission Control",
        "width": 1440,
        "height": 900,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One control plane for your SBC"
  }
}
