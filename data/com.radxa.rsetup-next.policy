<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>rsetup-next</vendor>
  <vendor_url>https://github.com/xzl01/rsetup-next</vendor_url>
  <action id="com.radxa.rsetup-next.manage-local-system">
    <description>Manage the local SBC through rsetup-next</description>
    <description xml:lang="zh_CN">通过 rsetup-next 管理本机开发板</description>
    <message>Authentication is required to change this SBC</message>
    <message xml:lang="zh_CN">更改本机开发板需要管理员授权</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/rsetup-next-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
